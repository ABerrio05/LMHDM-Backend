SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexo
DB_USERNAME=nexo_app
DB_PASSWORD=change_me

JWT_SECRET=replace_this_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_DEVELOPER_EMAIL=developer@example.com

# Alertas por correo. Actívalas solo cuando configures un proveedor SMTP real.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@tu-dominio.com
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=tu_usuario_smtp
MAIL_PASSWORD=tu_contrasena_o_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
REMINDER_POLL_DELAY_MS=60000

# Asistente de IA: proveedor compatible con /chat/completions.
# Ejemplo Gemini (API compatible con OpenAI):
# AI_ENABLED=true
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=pega_aqui_tu_clave_de_google_ai_studio
# AI_MODEL=gemini-3.5-flash-lite
# Nunca subas AI_API_KEY al repositorio ni la configures en el frontend.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

